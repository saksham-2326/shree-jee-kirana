# ==============================================================================
# Shree Jee Kirana - Global Environment Configuration Template
# Copy this file to .env in each corresponding directory and fill in your values.
# NEVER COMMIT REAL KEYS OR SERVICE SECRETS TO VERSION CONTROL.
# ==============================================================================

# ------------------------------------------------------------------------------
# SUPABASE CONFIGURATION
# Obtain from your Supabase Dashboard: Project Settings -> API
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
# SERVER-SIDE ONLY - NEVER EXPOSE IN MOBILE OR PUBLIC CLIENTS
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ------------------------------------------------------------------------------
# STORE & UPI CONFIGURATION (NO RAZORPAY)
# ------------------------------------------------------------------------------
# Primary Merchant UPI Virtual Payment Address (VPA)
UPI_MERCHANT_VPA=shreejeekirana@upi
UPI_MERCHANT_NAME=Shree Jee Kirana Store
UPI_MERCHANT_CODE=5411 # MCC for Grocery Stores & Supermarkets

# Payment Mode:
# 'intent'  -> Direct NPCI UPI Intent launch (Google Pay, PhonePe, Paytm, BHIM)
# 'gateway' -> UPI Payment Gateway adapter (PhonePe PG / Cashfree UPI)
# 'mock'    -> Development sandbox simulator (for testing without live merchant account)
PAYMENT_MODE=intent

# Optional Enterprise UPI Gateway Settings (e.g. PhonePe PG / Cashfree)
PHONEPE_MERCHANT_ID=
PHONEPE_SALT_KEY=
PHONEPE_SALT_INDEX=1
PHONEPE_ENV=UAT # UAT or PRODUCTION

# ------------------------------------------------------------------------------
# GOOGLE MAPS CONFIGURATION
# Obtain from Google Cloud Console: APIs & Services -> Credentials
# Enable: Maps SDK for Android, Maps SDK for iOS, Geocoding API, Places API
# ------------------------------------------------------------------------------
GOOGLE_MAPS_API_KEY_ANDROID=AIzaSy...
GOOGLE_MAPS_API_KEY_IOS=AIzaSy...

# ------------------------------------------------------------------------------
# FIREBASE CLOUD MESSAGING (FCM)
# Obtain from Firebase Console: Project Settings -> Cloud Messaging
# ------------------------------------------------------------------------------
FCM_SERVER_KEY=AAAA...
FIREBASE_PROJECT_ID=shree-jee-kirana
